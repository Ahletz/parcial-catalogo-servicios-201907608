# Plantilla OPCIONAL: compose.yaml ya trae defaults solo de evaluación (inseguros,
# no aptos para producción). Copiar a .env para sobrescribirlos; no versionar .env.
DJANGO_SECRET_KEY=CONFIGURAR_LOCALMENTE
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_COOKIES=false
DB_NAME=catalogo
DB_USER=catalogo
DB_PASSWORD=CONFIGURAR_LOCALMENTE
DB_HOST=db
DB_PORT=5432
APP_PORT=8000
# Cuentas exclusivamente demo. El comando nunca imprime contraseñas.
DEMO_ADMIN_IDENTIFICADOR=admin.demo
DEMO_ADMIN_PASSWORD=CONFIGURAR_LOCALMENTE
DEMO_CONSULTA_IDENTIFICADOR=consulta.demo
DEMO_CONSULTA_PASSWORD=CONFIGURAR_LOCALMENTE
DEMO_SD_PASSWORD=CONFIGURAR_LOCALMENTE
